---
// src/components/hobbit/RegionDrawer.astro
---

<aside
  id="region-drawer"
  class="fixed top-0 right-0 z-50 h-full w-full sm:w-[520px] bg-[#120d09] border-l border-[#c9a84c]/50 shadow-[-20px_0_60px_rgba(0,0,0,0.95)] transform translate-x-full transition-transform duration-300 ease-out flex flex-col font-serif"
  aria-label="Territory Details"
>
  <!-- Mobile Sheet Drag Handle Bar -->
  <div class="sm:hidden pt-2.5 pb-1 bg-[#18110a] flex items-center justify-center cursor-grab shrink-0" id="drawer-drag-handle">
    <div class="w-12 h-1.5 rounded-full bg-[#c9a84c]/50"></div>
  </div>

  <!-- Folio Header Bar (Antique Brass & Leather binding) -->
  <div class="flex items-center justify-between px-5 py-3 border-b border-[#c9a84c]/30 bg-[#18110a] shrink-0 shadow-md">
    <div class="flex items-center gap-2.5">
      <svg class="w-4 h-4 text-mtg-gold stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
      </svg>
      <span class="font-serif-title text-xs font-bold uppercase tracking-[0.18em] text-text-parchment">
        Territory Dossier
      </span>
    </div>
    
    <button
      id="close-drawer-btn"
      class="inline-flex items-center gap-1.5 min-w-[44px] min-h-[44px] px-2.5 py-1 text-xs font-serif-title font-bold uppercase tracking-wider text-text-parchment-muted hover:text-mtg-gold transition-colors cursor-pointer rounded border border-transparent hover:border-mtg-gold/40 hover:bg-[#251d13]"
      aria-label="Close territory record"
    >
      <span class="text-[10px] tracking-widest text-text-parchment-muted/80">ESC</span>
      <svg class="w-4 h-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Scrollable Card & Slip Viewport -->
  <div class="flex-1 overflow-y-auto px-4 py-5 sm:px-6 sm:py-6 space-y-6">
    <!-- THE PHYSICAL MTG CARD OBJECT -->
    <article id="drawer-mtg-card" class="mtg-card w-full shadow-2xl transition-all" style="--card-grad: linear-gradient(150deg, #3d9a64, #2f7d4f 48%, #1b4b2e 82%, #0d2818);">
      <div class="mtg-card__frame">
        <!-- 1. TITLE PLATE -->
        <div class="mtg-card__plate mtg-card__titlebar flex items-center justify-between gap-2 px-4 py-2.5">
          <h2 id="drawer-region-name" class="min-w-0 truncate font-serif-title font-bold uppercase tracking-tight text-lg md:text-xl leading-tight gold-foil-text">
            The Shire
          </h2>
          <div class="flex items-center gap-2.5 shrink-0">
            <span id="drawer-starting-badge" class="hidden font-serif-title text-[0.65rem] uppercase tracking-wider px-2 py-0.5 rounded font-bold bg-[#8a6e2f]/40 border border-mtg-gold/60 text-mtg-gold shadow-sm">
              Starter Realm
            </span>
            <div id="drawer-mana-pip-icon" class="w-7 h-7 rounded-full flex items-center justify-center shadow-md">
              <!-- Dynamically set by JS -->
            </div>
          </div>
        </div>

        <!-- 2. ART WINDOW (Clipped Territory Window) -->
        <div class="mtg-card__art aspect-[16/9] relative overflow-hidden bg-black/90 flex items-center justify-center">
          <img
            id="drawer-territory-art"
            src="/images/territories/shire.webp"
            alt="Territory Cartography"
            class="w-full h-full object-cover filter contrast-110 brightness-95 hover:scale-105 transition-transform duration-700"
          />
          <!-- Subtle vignette gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#140a07] via-transparent to-transparent opacity-90"></div>
          
          <!-- Controller Banner Floating Over Lower Art Frame -->
          <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between px-3 py-1.5 rounded bg-black/80 backdrop-blur-md border border-mtg-gold/40 shadow-lg">
            <div class="flex items-center gap-2.5 min-w-0">
              <div id="drawer-controller-avatar" class="w-6 h-6 rounded-full border border-mtg-gold bg-[#251d13] flex items-center justify-center text-mtg-gold overflow-hidden shrink-0">
                <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div class="truncate">
                <div id="drawer-controller-name" class="font-serif-title text-xs font-bold text-text-parchment truncate max-w-[200px]">
                  Unclaimed Frontier
                </div>
              </div>
            </div>
            <span id="drawer-conquest-status" class="font-serif-title text-[0.7rem] uppercase tracking-wider text-mtg-gold font-bold shrink-0">
              Unclaimed
            </span>
          </div>
        </div>

        <!-- 3. TYPE LINE PLATE -->
        <div class="mtg-card__plate mtg-card__typeline px-4 py-2 flex items-center justify-between gap-2">
          <span class="font-serif-title text-mtg-red-ember text-xs font-bold uppercase tracking-[0.14em]">
            Legendary Land — Middle-Earth
          </span>
          <span class="font-serif-title text-text-parchment-muted text-xs tracking-widest font-bold">
            CAMPAIGN 2026
          </span>
        </div>

        <!-- 4. TEXT BOX PLATE (Authentic MTG Rules, Saga-style Tabletop Chapters, Lore) -->
        <div class="mtg-card__plate mtg-card__textbox px-4.5 pt-3.5 pb-4 space-y-4">
          <!-- Domain Passive Rule -->
          <div class="font-serif-body text-[0.95rem] leading-snug text-text-parchment">
            <strong class="font-serif-title italic text-mtg-gold font-bold">Domain</strong> — If you control this domain at the beginning of a match night, earn campaign glory. Fulfill 2 trials to claim dominion.
          </div>

          <!-- Conquest Progress Indicator -->
          <div class="flex items-center justify-between px-3 py-1.5 rounded bg-black/50 border border-mtg-gold/25 text-xs">
            <span class="font-serif-title text-[0.7rem] uppercase tracking-wider text-mtg-gold font-bold">
              Conquest Status
            </span>
            <span id="drawer-claim-progress-text" class="font-serif-title text-xs font-bold text-text-parchment">
              0 of 2 trials fulfilled
            </span>
          </div>

          <!-- Divider with centered mana diamond -->
          <div class="relative flex items-center justify-center">
            <div class="h-px w-full bg-gradient-to-r from-transparent via-mtg-gold/30 to-transparent"></div>
            <span class="absolute px-2 bg-[#1c160e] text-mtg-gold text-[9px]">❖</span>
          </div>

          <!-- TABLETOP TRIALS (AUTHENTIC MTG SAGA CHAPTER LAYOUT — NO NESTED CARDS) -->
          <div class="space-y-1">
            <div class="font-serif-title text-xs uppercase tracking-[0.16em] text-mtg-gold font-bold mb-2 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-mtg-gold stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
                <line x1="13" y1="19" x2="19" y2="13"></line>
                <line x1="16" y1="16" x2="20" y2="20"></line>
                <line x1="19" y1="21" x2="21" y2="19"></line>
                <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
                <line x1="5" y1="14" x2="9" y2="18"></line>
                <line x1="7" y1="17" x2="4" y2="20"></line>
                <line x1="3" y1="19" x2="5" y2="21"></line>
              </svg>
              <span>Tabletop Trials</span>
            </div>
            
            <div id="drawer-achievements-list" class="space-y-3">
              <!-- Injected by client script with authentic MTG Saga chapters (I, II, III) -->
            </div>
          </div>

          <!-- Divider with centered mana diamond -->
          <div class="relative flex items-center justify-center pt-1">
            <div class="h-px w-full bg-gradient-to-r from-transparent via-mtg-gold/30 to-transparent"></div>
            <span class="absolute px-2 bg-[#1c160e] text-mtg-gold text-[9px]">❖</span>
          </div>

          <!-- LORE FLAVOR TEXT -->
          <blockquote id="drawer-region-lore" class="font-serif-body italic text-[0.92rem] text-text-parchment-muted/90 leading-relaxed border-l-2 border-mtg-gold/40 pl-3 py-0.5">
            "A pleasant corner of the quiet world, sheltered by Rangers. Home of halflings, second breakfasts, and unexpected courage."
          </blockquote>
        </div>
      </div>

      <!-- 5. COLLECTOR STRIP -->
      <span class="mtg-card__collector">
        001/012 LND • EN — Middle-Earth Campaign Series ™ & © 2026
      </span>
    </article>

    <!-- TABLETOP MATCH SLIP (Physical Tournament Cardstock Slip) -->
    <div id="drawer-claim-form-section" class="relative p-5 rounded-xl bg-[#19120b] border border-mtg-gold/50 shadow-xl space-y-4">
      <!-- Brass decorative corner accents -->
      <div class="flex items-center justify-between border-b border-mtg-gold/25 pb-2.5">
        <div>
          <h3 class="font-serif-title text-xs uppercase tracking-[0.16em] text-mtg-gold font-bold">
            Tabletop Match Slip
          </h3>
          <p class="font-serif-body italic text-xs text-text-parchment-muted">
            Record your physical game result for council verification.
          </p>
        </div>
        <svg class="w-4 h-4 text-mtg-gold stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"></polyline>
          <line x1="13" y1="19" x2="19" y2="13"></line>
          <line x1="16" y1="16" x2="20" y2="20"></line>
          <line x1="19" y1="21" x2="21" y2="19"></line>
          <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"></polyline>
          <line x1="5" y1="14" x2="9" y2="18"></line>
          <line x1="7" y1="17" x2="4" y2="20"></line>
          <line x1="3" y1="19" x2="5" y2="21"></line>
        </svg>
      </div>

      <form id="submit-claim-form" class="space-y-3.5">
        <input type="hidden" id="claim-region-id" name="regionId" />
        
        <div>
          <label for="claim-achievement-select" class="block font-serif-title text-[0.7rem] uppercase tracking-wider text-text-parchment font-bold mb-1.5">
            Trial Accomplished
          </label>
          <div class="relative">
            <select
              id="claim-achievement-select"
              name="achievementId"
              class="w-full appearance-none bg-[#120c08] border border-mtg-gold/40 hover:border-mtg-gold rounded px-3.5 py-2.5 pr-8 text-base sm:text-xs font-serif text-text-parchment focus:outline-none focus:border-mtg-gold focus:ring-1 focus:ring-mtg-gold transition-colors cursor-pointer"
              required
            >
              <option value="">Select completed trial...</option>
            </select>
            <div class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-mtg-gold text-xs">
              ▼
            </div>
          </div>
        </div>

        <div>
          <label for="claim-match-notes" class="block font-serif-title text-[0.7rem] uppercase tracking-wider text-text-parchment font-bold mb-1.5">
            Match Slip & Table Pod Notes
          </label>
          <textarea
            id="claim-match-notes"
            name="matchNotes"
            rows="2"
            placeholder="e.g. Table 3 with @Rohan & @Kiran. Cast The One Ring and survived on 2 life."
            class="w-full bg-[#120c08] border border-mtg-gold/40 hover:border-mtg-gold rounded px-3.5 py-2 text-base sm:text-xs font-serif text-text-parchment placeholder-text-parchment-muted/50 focus:outline-none focus:border-mtg-gold focus:ring-1 focus:ring-mtg-gold transition-colors"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          id="claim-submit-btn"
          class="btn-tap w-full min-h-[44px] py-2.5 px-4 rounded-md text-center font-serif-title font-bold text-xs uppercase tracking-[0.16em] cursor-pointer"
        >
          Submit Match Slip to Arbitrator
        </button>
      </form>
    </div>

    <!-- Login Required Prompt (if guest) -->
    <div id="drawer-login-prompt" class="hidden p-6 rounded-xl bg-[#19120b] border border-mtg-gold/40 text-center space-y-3.5 shadow-xl">
      <h3 class="font-serif-title text-sm font-bold uppercase tracking-[0.16em] text-mtg-gold">
        Sign In to Claim Territory
      </h3>
      <p class="font-serif-body italic text-xs text-text-parchment-muted max-w-xs mx-auto leading-relaxed">
        Authenticate your Discord profile to record table match trials, raise your banner across Middle-Earth, and rise in the Great Chronicle.
      </p>
      <button
        type="button"
        id="drawer-discord-login-btn"
        class="inline-flex items-center justify-center gap-2.5 w-full min-h-[44px] py-2.5 px-4 rounded-md bg-[#5865F2] hover:bg-[#4752C4] text-white font-serif-title font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer shadow-md"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Connect Discord Profile</span>
      </button>
    </div>
  </div>

  <!-- Sticky Bottom Action Bar for Mobile (Thumb-Accessible) -->
  <div class="sm:hidden p-3 border-t border-[#c9a84c]/30 bg-[#140f0a]/95 backdrop-blur-md sticky bottom-0 z-20 flex gap-2 pb-[calc(env(safe-area-inset-bottom,0px)+0.75rem)] shadow-[0_-4px_16px_rgba(0,0,0,0.8)]">
    <button
      id="mobile-close-drawer-bottom-btn"
      type="button"
      class="flex-1 min-h-[44px] py-2.5 px-4 rounded bg-[#1c160e] hover:bg-[#251d13] border border-[#c9a84c]/50 text-[#e8dcc8] font-serif-title text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 transition-colors cursor-pointer active:scale-[0.98]"
    >
      <svg class="w-4 h-4 text-mtg-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      <span>Back to Map</span>
    </button>
  </div>
</aside>
