---
/**
 * Site-wide announcement banner.
 *
 * Two responsive layouts:
 *   - Mobile  (<640px): a continuously scrolling marquee (aria-hidden).
 *   - Desktop (≥640px): a static, centered row.
 *
 * Honors prefers-reduced-motion (marquee stops animating).
 * Accessible: the visible marquee is aria-hidden; an sr-only copy of the
 * message + CTA is exposed to assistive tech via role="region".
 *
 * Palette: dark red (#7a1c1c) background, warm gold (#ffd9a0) text/CTA.
 */
interface Props {
  text: string;
  ctaText?: string;
  ctaHref?: string;
}

const { text, ctaText, ctaHref } = Astro.props;
const hasCta = Boolean(ctaText && ctaHref);
---

<div class="ann-banner" role="region" aria-label="Site announcement">
  <!-- Accessible, non-visual copy of the announcement -->
  <p class="sr-only">
    {text}
    {hasCta && (
      <a href={ctaHref} target="_blank" rel="noopener">{ctaText}</a>
    )}
  </p>

  <!-- Mobile: scrolling marquee (decorative; hidden from AT) -->
  <div class="ann-marquee" aria-hidden="true">
    <div class="ann-marquee__track">
      {Array.from({ length: 2 }).map(() => (
        <span class="ann-marquee__item">
          <button type="button" class="ann-marquee__text ann-text-btn" data-ann-open tabindex="-1">{text}</button>
          {hasCta && (
            <a class="ann-marquee__cta" href={ctaHref} target="_blank" rel="noopener" tabindex="-1">
              {ctaText}
              <span class="ann-arrow" aria-hidden="true">→</span>
            </a>
          )}
          <span class="ann-marquee__sep" aria-hidden="true">✦</span>
        </span>
      ))}
    </div>
  </div>

  <!-- Desktop: static centered row -->
  <div class="ann-static" aria-hidden="true">
    <button type="button" class="ann-static__text ann-text-btn" data-ann-open>{text}</button>
    {hasCta && (
      <a class="ann-static__cta" href={ctaHref} target="_blank" rel="noopener">
        {ctaText}
        <span class="ann-arrow" aria-hidden="true">→</span>
      </a>
    )}
  </div>
</div>

<!-- Full-text dialog, opened by clicking the announcement -->
<dialog id="ann-dialog" class="ann-dialog">
  <p class="ann-dialog__text">{text}</p>
  <div class="ann-dialog__actions">
    {hasCta && (
      <a class="ann-dialog__cta" href={ctaHref} target="_blank" rel="noopener">
        {ctaText}
      </a>
    )}
    <button type="button" class="ann-dialog__close" data-ann-close>Close</button>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("ann-dialog") as HTMLDialogElement | null;
  if (dialog) {
    document.querySelectorAll<HTMLElement>("[data-ann-open]").forEach((el) => {
      el.addEventListener("click", () => dialog.showModal());
    });
    dialog.querySelector("[data-ann-close]")?.addEventListener("click", () => dialog.close());
    // Click on the backdrop (the ::backdrop pseudo-element registers as a
    // click on the dialog itself, outside its content box) closes it too.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  /* Pride skin: full rainbow banner; text sits on a dark pill for legibility */
  .ann-banner {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: linear-gradient(90deg, #e40303, #ff8c00, #ffed00, #008026, #004dff, #750787);
    color: #ffffff;
    overflow: hidden;
    font-family: var(--font-sans-ui), sans-serif;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Shared text / CTA styling ──────────────────────────────── */
  /* Strong dark outline keeps white text legible over every stripe
     (incl. the bright yellow). */
  .ann-marquee__text,
  .ann-static__text {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 0 4px rgba(0, 0, 0, 0.7);
  }

  /* Reset the <button> used for the clickable announcement text, and add a
     hint that it opens something (underline on hover/focus). */
  .ann-text-btn {
    appearance: none;
    background: none;
    border: 0;
    margin: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .ann-static__text.ann-text-btn {
    max-width: min(60vw, 640px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ann-text-btn:hover,
  .ann-text-btn:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ann-text-btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .ann-marquee__cta,
  .ann-static__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 0 4px rgba(0, 0, 0, 0.7);
    transition: opacity 0.2s ease;
  }

  .ann-marquee__cta:hover,
  .ann-static__cta:hover {
    opacity: 0.8;
  }

  .ann-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .ann-marquee__cta:hover .ann-arrow,
  .ann-static__cta:hover .ann-arrow {
    transform: translateX(3px);
  }

  /* ── Mobile marquee ─────────────────────────────────────────── */
  .ann-marquee {
    display: flex;
    width: 100%;
    padding-block: 0.9rem;
  }

  .ann-marquee__track {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
    will-change: transform;
    animation: ann-scroll 18s linear infinite;
  }

  .ann-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding-inline: 0.75rem;
  }

  .ann-marquee__sep {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
  }

  @keyframes ann-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* ── Desktop static row ─────────────────────────────────────── */
  .ann-static {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-block: 0.9rem;
    padding-inline: 1rem;
    text-align: center;
  }

  /* ── Responsive switch ──────────────────────────────────────── */
  @media (min-width: 640px) {
    .ann-marquee { display: none; }
    .ann-static  { display: flex; }
  }

  /* ── Reduced motion ─────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ann-marquee__track {
      animation: none;
    }
    .ann-arrow {
      transition: none;
    }
  }

  /* ── Full-text dialog ───────────────────────────────────────── */
  .ann-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    margin: 0;
    transform: translate(-50%, -50%);
    max-width: min(90vw, 640px);
    max-height: min(85vh, 640px);
    overflow-y: auto;
    border: 0;
    border-radius: 12px;
    padding: 1.5rem;
    background: var(--color-bg-paper, #faf6f0);
    color: var(--color-text-ink, #1e1610);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }
  .ann-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .ann-dialog__text {
    font-family: var(--font-serif-body), serif;
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .ann-dialog__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .ann-dialog__cta {
    font-family: var(--font-sans-ui), sans-serif;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7a1c1c;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ann-dialog__close {
    appearance: none;
    border: 1px solid currentColor;
    border-radius: 6px;
    background: none;
    padding: 0.45rem 0.9rem;
    font-family: var(--font-sans-ui), sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    color: inherit;
  }
</style>
