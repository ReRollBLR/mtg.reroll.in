---
/**
 * Code of Conduct summary card, sitting next to the event card.
 * Same MTG construction as EventCard (black border → colored frame → embossed
 * plates with frame showing between): a short welcome blurb + a link to the
 * full code of conduct on reroll.in.
 */
---

<article class="mtg-card w-full" style="--card-grad:linear-gradient(150deg, var(--color-mtg-red-light), var(--color-mtg-red) 48%, var(--color-mtg-red-dark) 82%, var(--color-mtg-red-deep))">
  <div class="mtg-card__frame">
    <!-- Title plate -->
    <div class="mtg-card__plate mtg-card__titlebar flex items-center justify-between gap-2 px-3.5 py-2.5">
      <h3 class="min-w-0 truncate font-serif-title text-mtg-red-ember font-bold uppercase tracking-tight text-base md:text-lg leading-tight">
        Code of Conduct
      </h3>
      <span class="shrink-0 text-mtg-red-light/80 text-lg leading-none select-none" aria-hidden="true">✦</span>
    </div>

    <!-- Art window — the ReRoll collective logo -->
    <div class="mtg-card__art mtg-card__art--logo aspect-[16/9] flex items-center justify-center">
      <img src="/images/logo-header.png" alt="ReRoll — the board games collective" loading="lazy" />
    </div>

    <!-- Type line (repurposed for the document subtitle) -->
    <div class="mtg-card__plate mtg-card__typeline px-3 py-2 flex items-center justify-between gap-2">
      <span class="font-serif-title text-mtg-red-ember text-[0.7rem] md:text-xs font-bold uppercase tracking-[0.12em]">
        Community Codex
      </span>
      <span class="font-sans-ui text-text-parchment-muted text-[0.6rem] uppercase tracking-[0.16em]">
        Rulebook
      </span>
    </div>

    <!-- Text box — the welcome blurb + button -->
    <div class="mtg-card__plate mtg-card__textbox px-4 pt-3 pb-4">
      <p class="font-serif-body text-[1.02rem] leading-snug text-text-parchment">
        ReRoll is a friendly, safe, and welcoming space for all players. We
        expect everyone at our tables to treat others with patience and
        kindness, respect shared board games, and keep our community inclusive
        and harassment-free.
      </p>

      <div class="mt-auto pt-4 flex flex-col gap-3">
        <a
          href="https://reroll.in/code-of-conduct/"
          target="_blank"
          rel="noopener"
          class="btn-tap rounded-md text-center font-sans-ui text-xs font-bold uppercase tracking-[0.16em] px-5 py-3"
        >
          Read the Code of Conduct
        </a>
      </div>
    </div>
  </div>
</article>
