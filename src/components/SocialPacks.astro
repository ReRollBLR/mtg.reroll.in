---
/**
 * Social links as unopened booster packs lying flat on a surface.
 * A single slightly-scattered row (random tilt + slight overlap) that wraps to
 * 2×2 on mobile. Each pack is a direct link — one tap opens that social.
 * Brand color per pack (§7 polychrome inside the frame); gold foil accents.
 * Shared easing on the pick-up hover. No JS, no FLIP.
 */
import { socials } from "../config/site";

// Brand icon files (public/icons). Masked ones are painted white to match the
// foil treatment; full-color ones render as-is via <img>.
const iconFiles: Record<string, string> = {
  discord: "/icons/discord-logo.svg",
  instagram: "/icons/instagram-logo.svg",
  whatsapp: "/icons/whatsapp-logo.svg",
  underline: "/icons/underline-logo.svg",
};

// Icons that keep their own colors (rendered as <img>, not masked white).
const fullColorIcons = new Set(["underline"]);

// Inline SVG fallback (currentColor) for socials without an uploaded file.
const icons: Record<string, string> = {
  reroll:
    '<path d="M21 12a9 9 0 1 1-3-6.7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 3v5h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
};

// Foil wrapper gradient per brand (the pack's body color) — brightened: lighter,
// more saturated mid + end stops so the foil pops instead of sinking to dark.
const themeGrad: Record<string, string> = {
  reroll: "linear-gradient(155deg, #f4dd8e 0%, #e0b347 45%, #a87d2c 100%)",
  discord: "linear-gradient(155deg, #b4c0ff 0%, #6f7bff 45%, #3a48c0 100%)",
  instagram: "linear-gradient(155deg, #ff9ec2 0%, #ec4a82 45%, #b03059 100%)",
  underline: "linear-gradient(155deg, #cfbcff 0%, #936bff 45%, #5b34c8 100%)",
  whatsapp: "linear-gradient(155deg, #8dfbb4 0%, #2fe077 45%, #1c9a4d 100%)",
};

// Subtle alternating tilt so the inline row/column reads as deliberately
// lined up (not tossed). Deterministic → stable SSR (no hydration jump).
const tilts = [-1.5, 1.5, -1.5, 1.5];
const nudges = [0, 0, 0, 0]; // kept in line — no vertical nudge
---

<div class="pack-table" role="list" aria-label="Find us on socials">
  {socials.map((s, i) => (
    <a
      href={s.href}
      target="_blank"
      rel="noopener"
      role="listitem"
      class="pack"
      style={`--pack-grad:${themeGrad[s.theme]}; --tilt:${tilts[i % tilts.length]}deg; --nudge:${nudges[i % nudges.length]}px`}
      aria-label={`${s.label} — ${s.handle}`}
    >
      <span class="pack__body">
        <!-- serrated tear strip + hang hole at the top -->
        <span class="pack__crimp" aria-hidden="true"></span>
        <span class="pack__hole" aria-hidden="true"></span>
        <!-- foil sheen sweep -->
        <span class="pack__sheen" aria-hidden="true"></span>

        <span class="pack__content">
          {iconFiles[s.icon] ? (
            fullColorIcons.has(s.icon) ? (
              <span class="pack__icon" data-icon={s.icon} aria-hidden="true">
                <img src={iconFiles[s.icon]} alt="" />
              </span>
            ) : (
              <span
                class="pack__icon pack__icon--mask"
                data-icon={s.icon}
                style={`--icon-url:url(${iconFiles[s.icon]})`}
                aria-hidden="true"
              ></span>
            )
          ) : (
            <span class="pack__icon" data-icon={s.icon} aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={icons[s.icon]}></svg>
            </span>
          )}
          <span class="pack__label font-serif-title">{s.label}</span>
          <span class="pack__handle font-serif-body">{s.handle}</span>
        </span>
      </span>
    </a>
  ))}
</div>

<style>
  .pack-table {
    /* desktop: all packs in one horizontal line */
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(0.6rem, 3vw, 1.4rem);
    max-width: 900px;
    margin-inline: auto;
    /* packs rest on the real .table-surface; each pack carries its own shadow */
    padding: 1.5rem 1rem 2.5rem;
  }

  .pack {
    --pack-w: clamp(124px, 22vw, 172px);
    display: block;
    width: var(--pack-w);
    /* lying flat on the table */
    transform: rotate(var(--tilt)) translateY(var(--nudge));
    transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
                filter 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    /* table contact shadow (soft, for a light surface) */
    filter: drop-shadow(0 8px 10px rgba(30, 22, 16, 0.22));
    -webkit-tap-highlight-color: transparent;
  }
  /* picked up off the table on hover/focus */
  .pack:hover,
  .pack:focus-visible {
    transform: rotate(0deg) translateY(-12px) scale(1.04);
    filter: drop-shadow(0 18px 16px rgba(30, 22, 16, 0.32));
    z-index: 5;
    outline: none;
  }

  .pack__body {
    position: relative;
    display: block;
    aspect-ratio: 5 / 7.4;
    border-radius: 7px;
    background: var(--pack-grad);
    border: 1px solid rgba(0, 0, 0, 0.45);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.22) inset,
      0 -8px 16px rgba(0, 0, 0, 0.15) inset;
    overflow: hidden;
    padding-top: 14px; /* room for the crimp */
  }

  /* serrated heat-seal crimp across the top (the tear strip) */
  .pack__crimp {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 14px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.35) 0 3px,
        rgba(255, 255, 255, 0.12) 3px 6px
      );
    border-bottom: 1px solid rgba(0, 0, 0, 0.5);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
  }
  /* punched hang hole */
  .pack__hole {
    position: absolute;
    top: 3px; left: 50%;
    width: 8px; height: 8px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: var(--color-bg-dark, #0e0c0a);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(0,0,0,0.6);
  }
  /* diagonal foil sheen */
  .pack__sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgba(255, 255, 255, 0.28) 47%,
      rgba(255, 255, 255, 0.05) 55%,
      transparent 65%
    );
    pointer-events: none;
  }

  .pack__content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.75rem 0.5rem 1rem;
    text-align: center;
    /* lighter glossy label scrim — enough to read text, foil still shows through */
    background: radial-gradient(120% 70% at 50% 55%, rgba(14, 12, 10, 0.45), rgba(14, 12, 10, 0.18) 70%, transparent);
  }
  .pack__icon {
    color: #fff;
    width: 2.2rem;
    height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    /* dark halo so the logo reads on any foil color */
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.85))
            drop-shadow(0 0 5px rgba(0, 0, 0, 0.5));
  }
  .pack__icon :global(svg),
  .pack__icon :global(img) { width: 100%; height: 100%; object-fit: contain; }

  /* Per-logo optical scale — the uploaded glyphs fill their viewBoxes by
     different amounts, so equalize how big each *reads* in the fixed box. */
  .pack__icon[data-icon="discord"] :global(svg),
  .pack__icon[data-icon="discord"] :global(img) { transform: scale(0.92); }
  .pack__icon[data-icon="instagram"] :global(svg),
  .pack__icon[data-icon="instagram"] :global(img) { transform: scale(0.9); }
  .pack__icon[data-icon="whatsapp"] :global(svg),
  .pack__icon[data-icon="whatsapp"] :global(img) { transform: scale(0.92); }
  .pack__icon[data-icon="underline"] :global(svg),
  .pack__icon[data-icon="underline"] :global(img) { transform: scale(1.05); }

  /* masked variant: scale via mask-size instead (no inner element) */
  .pack__icon--mask[data-icon="discord"]   { mask-size: 92%; -webkit-mask-size: 92%; }
  .pack__icon--mask[data-icon="instagram"] { mask-size: 90%; -webkit-mask-size: 90%; }
  .pack__icon--mask[data-icon="whatsapp"]  { mask-size: 92%; -webkit-mask-size: 92%; }
  /* uploaded brand SVGs painted white via mask so they match the foil treatment */
  .pack__icon--mask {
    background-color: #fff;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }
  /* Banner-style text: white, bold, uppercase, strong dark outline for legibility */
  .pack__label {
    color: #ffffff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(0.82rem, 3vw, 1rem);
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 0 4px rgba(0, 0, 0, 0.7);
  }
  .pack__handle {
    color: #ffffff;
    font-weight: 500;
    font-size: 0.72rem;
    line-height: 1.2;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.9),
      0 0 4px rgba(0, 0, 0, 0.7);
  }

  @media (max-width: 640px) {
    /* mobile: 2×2 grid */
    .pack-table {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      justify-items: center;
      align-items: start;
      gap: 1.1rem 0.9rem;
      max-width: 340px;
    }
    .pack { --pack-w: clamp(130px, 40vw, 160px); width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pack { transition: filter 0.2s ease; }
    .pack:hover,
    .pack:focus-visible { transform: rotate(var(--tilt)) translateY(var(--nudge)); }
  }
</style>
