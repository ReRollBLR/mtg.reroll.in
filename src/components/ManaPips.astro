---
/**
 * WUBRG mana symbols, drawn as authentic Magic mana pips: a pale colored disc
 * with a dark glyph inside (sun / droplet / skull / flame / tree), matching how
 * Wizards prints them — NOT flat colored dots.
 *
 * `symbols` picks which to show, in order (default: all five WUBRG).
 * `pulse` adds a gentle staggered bob to draw the eye (respects reduced motion).
 * `size` is the pip diameter in px.
 */
type Sym = "w" | "u" | "b" | "r" | "g";
interface Props {
  symbols?: Sym[];
  pulse?: boolean;
  size?: number;
}
const { symbols = ["w", "u", "b", "r", "g"], pulse = false, size = 16 } = Astro.props;

// disc fill (pale, per WotC) — reads as the color without being garish
const disc: Record<Sym, string> = {
  w: "#f7f3df", // white  — cream
  u: "#a9dcf5", // blue   — sky
  b: "#cabfbb", // black  — pale grey-mauve (black mana is on a light disc)
  r: "#f6a98e", // red    — salmon
  g: "#9ad2ad", // green  — sage
};
const ink = "#15110c";
---

<span class:list={["mana-pips", { "mana-pips--pulse": pulse }]} aria-hidden="true">
  {symbols.map((s) => (
    <span class="mana-pip" style={`--disc:${disc[s]};width:${size}px;height:${size}px`}>
      {s === "w" && (
        <svg viewBox="0 0 24 24" fill="none" stroke={ink} stroke-width="2" stroke-linecap="round">
          <circle cx="12" cy="12" r="4.2" fill={ink} stroke="none"></circle>
          <line x1="12" y1="2.5" x2="12" y2="5.2"></line>
          <line x1="12" y1="18.8" x2="12" y2="21.5"></line>
          <line x1="2.5" y1="12" x2="5.2" y2="12"></line>
          <line x1="18.8" y1="12" x2="21.5" y2="12"></line>
          <line x1="5.2" y1="5.2" x2="7.1" y2="7.1"></line>
          <line x1="16.9" y1="16.9" x2="18.8" y2="18.8"></line>
          <line x1="18.8" y1="5.2" x2="16.9" y2="7.1"></line>
          <line x1="7.1" y1="16.9" x2="5.2" y2="18.8"></line>
        </svg>
      )}
      {s === "u" && (
        <svg viewBox="0 0 24 24" fill={ink}>
          <path d="M12 3.5c-3.4 4.2-6 7.4-6 10.6a6 6 0 0 0 12 0c0-3.2-2.6-6.4-6-10.6z"></path>
        </svg>
      )}
      {s === "b" && (
        <svg viewBox="0 0 24 24" fill={ink}>
          <path d="M12 4c-4.2 0-7.2 3-7.2 6.8 0 2.2 1.1 3.9 2.6 5v2.1c0 .7.5 1.1 1.1 1.1h.9v-1.8h1.3v1.8h1.3v-1.8h1.3v1.8h.9c.6 0 1.1-.4 1.1-1.1v-2.1c1.5-1.1 2.6-2.8 2.6-5C19.2 7 16.2 4 12 4z"></path>
          <circle cx="9.2" cy="11.2" r="1.7" fill={disc[s]}></circle>
          <circle cx="14.8" cy="11.2" r="1.7" fill={disc[s]}></circle>
        </svg>
      )}
      {s === "r" && (
        <svg viewBox="0 0 24 24" fill={ink}>
          <path d="M13.5 3c.6 2.6-.8 4.1-2.3 5.6C9.4 10.3 7.5 12 7.5 15a4.5 4.5 0 0 0 9 0c0-1.7-.7-2.9-1.4-4 .1 1-.4 1.9-1.1 2.3.5-2-.6-4.3-1.8-5.6.6 1.6-.2 2.7-.9 3.4.5-2.4-.2-5.6 2.2-8.1z"></path>
        </svg>
      )}
      {s === "g" && (
        <svg viewBox="0 0 24 24" fill={ink}>
          <rect x="11" y="13" width="2" height="7" rx="0.6"></rect>
          <path d="M12 3.5c-3 0-5.2 2.3-5.2 5 0 1.2.5 2.3 1.3 3.1-.6.6-1 1.5-1 2.4 0 .6.2 1.1.5 1.6.8-1.1 2-1.8 3.2-2.3v-2.6l-1.8-1.4 1.8.3V8.4l-1.5-1.6 1.5.6V5.2c.4-.4.9-.6 1.2-.6s.8.2 1.2.6v2.2l1.5-.6L13 8.4v1.2l1.8-.3-1.8 1.4v2.6c1.2.5 2.4 1.2 3.2 2.3.3-.5.5-1 .5-1.6 0-.9-.4-1.8-1-2.4.8-.8 1.3-1.9 1.3-3.1 0-2.7-2.2-5-5.2-5z"></path>
        </svg>
      )}
    </span>
  ))}
</span>
