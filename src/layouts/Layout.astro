---
import "../styles/global.css";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import { announcement } from "../config/announcement";
import { links } from "../config/site";

interface Props {
  title?: string;
  seoTitle?: string;
  description?: string;
  tagline?: string;
  /** Hides the "Magic: The Gathering / Bangalore" masthead heading + tagline. Defaults to shown. */
  showHeading?: boolean;
  image?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  seoTitle,
  description = "Join Bangalore's Magic: The Gathering (MTG) community! Weekly Saturday meetups in Indiranagar, Bengaluru. Casual Commander (EDH), Jumpstart for beginners & deck trading with ReRoll Board Games.",
  tagline,
  showHeading = true,
  image = "/images/logo-header.png",
  schema,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, "") : "https://mtg.reroll.in";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL(image, siteUrl).href;

const pageTitle =
  seoTitle ||
  (title && title !== "Home"
    ? `${title} | Magic: The Gathering Bangalore - MTG ReRoll`
    : "Magic: The Gathering Bangalore | MTG Meetups & Community Bengaluru | ReRoll");
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Primary SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="ReRoll Board Games" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta
      name="keywords"
      content="Magic The Gathering Bangalore, MTG Bangalore, MTG Bengaluru, Magic The Gathering Bengaluru, MTG India, Commander Bangalore, EDH Bangalore, Tabletop Games Bangalore, Board Games Bengaluru, ReRoll Board Games, Underline Center Indiranagar, Trading Card Games Bangalore, Learn MTG Bangalore, MTG Draft Bangalore"
    />

    <!-- Geo & Local SEO for Bangalore / Bengaluru audience -->
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Bengaluru, Karnataka, India" />
    <meta name="geo.position" content="12.9784;77.6408" />
    <meta name="ICBM" content="12.9784, 77.6408" />

    <!-- Open Graph / Facebook / WhatsApp / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MTG ReRoll Bangalore" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="Magic: The Gathering Bangalore Community - ReRoll Board Games" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Magic: The Gathering Bangalore Community - ReRoll Board Games" />

    <!-- Structured Data (JSON-LD): Organization & WebSite -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["CommunityOrganization", "LocalBusiness"],
            "@id": "https://mtg.reroll.in/#organization",
            "name": "Magic: The Gathering Bangalore - MTG ReRoll",
            "alternateName": [
              "MTG Bangalore",
              "MTG Bengaluru",
              "Magic The Gathering Bengaluru",
              "ReRoll MTG"
            ],
            "description": "Bangalore's dedicated community for Magic: The Gathering (MTG) players. Weekly Saturday meetups, Commander (EDH) pods, beginner Jumpstart sessions, and deck trading at Underline Center, Indiranagar, Bengaluru.",
            "url": "https://mtg.reroll.in",
            "logo": `${siteUrl}/images/logo-header.png`,
            "image": `${siteUrl}/images/mtg-art.webp`,
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Underline Center, Indiranagar",
              "addressLocality": "Bengaluru",
              "addressRegion": "Karnataka",
              "postalCode": "560038",
              "addressCountry": "IN"
            },
            "geo": {
              "@type": "GeoCoordinates",
              "latitude": 12.9784,
              "longitude": 77.6408
            },
            "parentOrganization": {
              "@type": "Organization",
              "name": "ReRoll Board Games",
              "url": "https://reroll.in"
            },
            "sameAs": [
              "https://reroll.in",
              "https://www.instagram.com/mtg_bangalore/",
              "https://reroll.in/chat",
              "https://reroll.in/whatsapp-mtg",
              "https://underline.center/t/magic-the-gathering-with-reroll-board-games/130"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "https://mtg.reroll.in/#website",
            "url": "https://mtg.reroll.in",
            "name": "Magic: The Gathering Bangalore | MTG ReRoll",
            "description": "Magic: The Gathering community and weekly meetups in Bangalore / Bengaluru, India.",
            "publisher": {
              "@id": "https://mtg.reroll.in/#organization"
            },
            "inLanguage": "en-IN"
          }
        ]
      })}
    />

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}

    <!-- Google Fonts Preconnect and Asynchronous Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=EB+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@500;700&display=swap"
      />
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col">
    {announcement.enabled && (
      <AnnouncementBanner
        text={announcement.text}
        ctaText={announcement.ctaText}
        ctaHref={announcement.ctaHref}
      />
    )}

    <!-- The white surface now fills the whole page (full height + width), so the
         dark backdrop never peeks out above/below the content. -->
    <div class="table-surface flex flex-col items-center flex-1 w-full px-4 md:px-8 pt-4 md:pt-6 pb-8 text-text-ink">
      <!-- Vintage corner ornaments — pinned to the page frame's corners -->
      <div class="ornament-corner ornament-tl"></div>
      <div class="ornament-corner ornament-tr"></div>
      <div class="ornament-corner ornament-bl"></div>
      <div class="ornament-corner ornament-br"></div>

      <!-- the threshold: back to the reroll superhome -->
      <a
        href={links.reroll}
        class="group self-start inline-flex items-center gap-2 font-sans-ui text-[0.7rem] uppercase tracking-[0.18em] font-bold text-brand-red-light hover:text-brand-red transition-colors mb-4 ml-[6%] md:ml-[10%]"
      >
        <span class="inline-block transition-transform duration-300 group-hover:-translate-x-1">←</span>
        Back to ReRoll
      </a>

      <div
        id="main-board-container"
        class="w-full max-w-6xl text-text-ink p-2 md:p-6 relative"
      >
        <header class="flex flex-col items-center justify-center mb-8 md:mb-12 border-b border-brand-red/20 pb-8 text-center">
          {showHeading && (
            <a href="/" class="group flex flex-col items-center">
              <h1
                id="site-title"
                class="font-serif-title title-glow uppercase font-bold tracking-[0.12em] text-3xl md:text-5xl leading-tight transition-transform duration-300 group-hover:scale-[1.02]"
              >
                Magic: The Gathering<br /><span class="text-xl md:text-3xl tracking-[0.2em]">Bangalore</span>
              </h1>
            </a>
          )}
          {tagline && (
            <p class="font-serif-body text-sm md:text-base italic text-text-ink-muted mt-4 max-w-xl leading-relaxed">
              {tagline}
            </p>
          )}
        </header>

        <main><slot /></main>

        <footer class="mt-12 md:mt-16 pt-8 border-t border-brand-red/20 text-center">
          <div class="flex flex-col items-center gap-2">
            <p class="font-sans-ui text-xs tracking-wider text-text-ink-muted uppercase">
              © {new Date().getFullYear()} ReRoll Board Games • Magic: The Gathering Bangalore / Bengaluru
            </p>
            <p class="font-sans-ui text-[0.72rem] text-text-ink-muted/80">
              Weekly MTG Meetups at Underline Center, Indiranagar, Bengaluru, Karnataka, India
            </p>
          </div>
        </footer>
      </div>
    </div>
  </body>
</html>
