---
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import ImageCard from "../components/ImageCard.astro";
import CodeOfConduct from "../components/CodeOfConduct.astro";
import FaqCard from "../components/FaqCard.astro";
import SocialPacks from "../components/SocialPacks.astro";
import { getEventCards } from "../config/site";

// Build-time fetch of the live event feed (falls back to the canonical event).
const events = await getEventCards();

// Structured Event Schema for Google Event rich snippets
const featuredEvent = events[0];
const eventSchema = featuredEvent
  ? {
      "@context": "https://schema.org",
      "@type": "Event",
      "name": `${featuredEvent.title} - Magic: The Gathering Bangalore Meetup`,
      "description": `${featuredEvent.blurb} Weekly MTG community meetup in Bengaluru organized by ReRoll Board Games. Casual Commander (EDH), Jumpstart for beginners, and card trading.`,
      "image": "https://mtg.reroll.in/images/mtg-art.webp",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": featuredEvent.venue || "Underline Center, Indiranagar",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Underline Center, Indiranagar",
          "addressLocality": "Bengaluru",
          "addressRegion": "Karnataka",
          "postalCode": "560038",
          "addressCountry": "IN",
        },
      },
      "organizer": {
        "@type": "Organization",
        "name": "ReRoll Board Games",
        "url": "https://reroll.in",
      },
      "offers": {
        "@type": "Offer",
        "url": featuredEvent.ctaHref,
        "price": "349",
        "priceCurrency": "INR",
        "availability": "https://schema.org/InStock",
        "validFrom": "2024-01-01",
      },
    }
  : undefined;
---

<Layout
  seoTitle="Magic: The Gathering Bangalore | MTG Meetups & Community Bengaluru | ReRoll"
  description="Join Bangalore's Magic: The Gathering (MTG) community! Weekly Saturday meetups in Indiranagar, Bengaluru. Casual Commander, Jumpstart for beginners & deck trading with ReRoll Board Games."
  tagline="Bangalore's dedicated Magic: The Gathering community. Weekly Saturday meetups at Underline Center, Indiranagar, Bengaluru. Extremely beginner-friendly — come along even if you don't know anything about MTG, we'll teach you!"
  schema={eventSchema}
>
  <!-- Upcoming Events Section Heading -->
  <div class="text-center mt-3 mb-6">
    <h2 class="font-serif-title text-mtg-gold uppercase tracking-[0.2em] text-xs md:text-sm font-bold">
      Upcoming Events &amp; Community Meetups in Bangalore
    </h2>
    <p class="font-serif-body italic text-text-ink-muted text-sm mt-1">
      Every Saturday at Underline Center, Indiranagar, Bengaluru
    </p>
  </div>

  <!-- 2x2 MTG Card Grid: Event, Schedule, FAQ, Code of Conduct -->
  <section class="w-full max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 items-stretch mt-4">
    {events.length > 0 ? (
      <>
        {events.map((event) => (
          <div class="flex w-full"><EventCard event={event} /></div>
        ))}
        <!-- September schedule — image-only card with expander -->
        <div class="flex w-full">
          <ImageCard title="September Schedule" image="/images/schedule.png" />
        </div>
      </>
    ) : (
      <div class="md:col-span-2">
        <div class="callout-dashed-gold text-center px-6 py-10">
          <p class="font-serif-title text-mtg-gold uppercase tracking-wide text-lg font-bold">
            No upcoming events
          </p>
          <p class="font-serif-body italic text-text-ink/90 mt-3 leading-relaxed">
            Join our socials in the meantime!
          </p>
          <p class="font-sans-ui text-[0.65rem] uppercase tracking-[0.16em] text-text-ink-muted mt-4">
            If you think this is an error please contact us
          </p>
        </div>
      </div>
    )}

    <!-- FAQ teaser, linking to the full /faq page -->
    <div class="flex w-full"><FaqCard /></div>

    <!-- Code of Conduct, next to the FAQ card -->
    <div class="flex w-full"><CodeOfConduct /></div>
  </section>

  <!-- Find us: the booster packs -->
  <section class="w-full mt-20 md:mt-28">
    <h2 class="font-serif-title title-glow text-center text-2xl md:text-3xl font-bold uppercase tracking-[0.14em]">
      Find Us in Bangalore
    </h2>
    <p class="text-center font-serif-body italic text-text-ink-muted mt-3 mb-8">
      Crack open a pack — connect with the Bengaluru MTG community on Discord, WhatsApp, and Instagram.
    </p>
    <SocialPacks />
  </section>
</Layout>
