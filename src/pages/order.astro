---
import Layout from "../layouts/Layout.astro";

/**
 * /order — a custom-styled front end for the "order pickup" Google Form.
 * Posts directly to the form's formResponse endpoint via a hidden iframe, so
 * visitors never leave the site or see the raw Google Forms UI. Entry IDs and
 * the two disclaimer checkbox values below must stay in sync with the live
 * form (docs.google.com/forms/d/e/1FAIpQLSftKjJ2LglCdGb3C6gh-oYA0o2ot9MO1tJP30TFyzuVxEPzww) —
 * if a field is added/removed/reworded there, mirror the change here too.
 */
const FORM_ACTION =
  "https://docs.google.com/forms/d/e/1FAIpQLSftKjJ2LglCdGb3C6gh-oYA0o2ot9MO1tJP30TFyzuVxEPzww/formResponse";

// The checkbox question's option text must match the live form exactly — the
// value sent has to equal the option label character-for-character.
const DISCLAIMER_PICKUP =
  "I understand that I will need to pick up my item(s) from Underline Center in person on one of the upcoming MTG Saturdays. I agree to inform Ravi in advance which Saturday I plan to come for pickup (contact: )";
const DISCLAIMER_TIMELINE =
  "I understand that items may take approximately 15–30 days to arrive after the order is placed";
---

<Layout
  title="Order"
  description="Ask us to pick up singles or sealed product for you — order here and collect it at a Saturday meetup."
  showHeading={false}
>
  <section class="w-full max-w-2xl mx-auto">
    <h2 class="font-serif-title title-glow text-center text-2xl md:text-3xl font-bold uppercase tracking-[0.14em] mb-3">
      Place an Order
    </h2>
    <p class="text-center font-serif-body italic text-text-ink-muted mb-6">
      Tell us what you want — one item or a whole stack of them — and we'll grab it for you.
    </p>

    <div class="callout-dashed-gold px-5 py-4 mb-10">
      <p class="font-serif-body text-sm leading-relaxed text-text-ink/90">
        This is for <strong>bulk orders</strong> — Ravi will get back to you with discounted pricing. You can reach him directly at{" "}
        <a href="tel:+919945565839" class="font-semibold text-brand-red underline underline-offset-4 decoration-brand-red/40 hover:text-brand-red-dark transition-colors">+91 99455 65839</a>.
      </p>
    </div>

    <div class="border border-brand-red/20 rounded-xl bg-bg-paper shadow-sm px-5 py-6 md:px-8 md:py-8">
      <!-- Hidden target: the form posts here instead of navigating the page -->
      <iframe
        name="order-hidden-frame"
        id="order-hidden-frame"
        title="Order submission"
        aria-hidden="true"
        tabindex="-1"
        class="hidden"
      ></iframe>

      <form
        id="order-form"
        action={FORM_ACTION}
        method="POST"
        target="order-hidden-frame"
        class="flex flex-col gap-6"
      >
        <div>
          <label for="order-name" class="font-sans-ui text-[0.7rem] uppercase tracking-[0.14em] font-bold text-brand-red-dark mb-2 block">
            Your name
          </label>
          <input
            id="order-name"
            name="entry.1602734444"
            type="text"
            required
            autocomplete="name"
            placeholder="Ravi Ramchandani"
            class="w-full rounded-md border border-brand-red/25 bg-white px-4 py-3 font-serif-body text-base text-text-ink placeholder:text-text-ink-muted/50 focus:outline-none focus:border-brand-red/60 focus:ring-2 focus:ring-brand-red/25 transition-colors"
          />
        </div>

        <div>
          <label for="order-phone" class="font-sans-ui text-[0.7rem] uppercase tracking-[0.14em] font-bold text-brand-red-dark mb-2 block">
            Phone number
          </label>
          <input
            id="order-phone"
            name="entry.1021578937"
            type="tel"
            inputmode="tel"
            required
            autocomplete="tel"
            placeholder="98765 43210"
            class="w-full rounded-md border border-brand-red/25 bg-white px-4 py-3 font-serif-body text-base text-text-ink placeholder:text-text-ink-muted/50 focus:outline-none focus:border-brand-red/60 focus:ring-2 focus:ring-brand-red/25 transition-colors"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <span class="font-sans-ui text-[0.7rem] uppercase tracking-[0.14em] font-bold text-brand-red-dark">
              What are you ordering?
            </span>
            <span class="font-sans-ui text-[0.65rem] uppercase tracking-[0.1em] text-text-ink-muted">
              Total qty: <span id="order-total-qty" class="text-brand-red font-bold">1</span>
            </span>
          </div>

          <div id="order-items" class="flex flex-col gap-4"></div>

          <button
            type="button"
            id="add-item-btn"
            class="mt-3 self-start rounded-md border-2 border-dashed border-brand-red/35 px-4 py-2 font-sans-ui text-xs font-bold uppercase tracking-[0.12em] text-brand-red hover:border-brand-red hover:bg-brand-red-pale transition-colors"
          >
            + Add another item
          </button>

          <p class="font-sans-ui text-xs text-text-ink-muted mt-3">
            Ordering more than one thing? Add a row per item — each with its own link and quantity — and we'll total it up for you.
          </p>

          <!-- The Google Form only has one field for this ("Product name /
               description", a paragraph question) — the item rows above are
               flattened into it as a single multi-line summary right before
               submit (see the script below). -->
          <input type="hidden" id="order-items-field" name="entry.1560991891" />
        </div>

        <!-- One item row's markup — cloned by the script for every row,
             including the first (seeded on load). -->
        <template id="order-item-template">
          <div class="order-item flex flex-col gap-3 rounded-lg border border-brand-red/20 bg-white/60 p-4" data-item>
            <div class="flex items-center justify-between">
              <span class="item-index font-sans-ui text-[0.65rem] uppercase tracking-[0.14em] font-bold text-text-ink-muted">Item 1</span>
              <button type="button" class="remove-item-btn hidden font-sans-ui text-[0.65rem] uppercase tracking-[0.1em] font-bold text-brand-red/70 hover:text-brand-red transition-colors">
                Remove
              </button>
            </div>
            <textarea
              class="item-name-input w-full rounded-md border border-brand-red/25 bg-white px-3 py-2 font-serif-body text-base text-text-ink placeholder:text-text-ink-muted/50 focus:outline-none focus:border-brand-red/60 focus:ring-2 focus:ring-brand-red/25 transition-colors resize-y"
              rows="2"
              required
              placeholder="e.g. Foundations booster box"
            ></textarea>
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_6rem] gap-3">
              <input
                type="url"
                class="item-link-input w-full rounded-md border border-brand-red/25 bg-white px-3 py-2 font-serif-body text-base text-text-ink placeholder:text-text-ink-muted/50 focus:outline-none focus:border-brand-red/60 focus:ring-2 focus:ring-brand-red/25 transition-colors"
                placeholder="Link (optional)"
              />
              <input
                type="number"
                class="item-qty-input w-full rounded-md border border-brand-red/25 bg-white px-3 py-2 font-serif-body text-base text-text-ink focus:outline-none focus:border-brand-red/60 focus:ring-2 focus:ring-brand-red/25 transition-colors"
                min="1"
                step="1"
                value="1"
                required
              />
            </div>
          </div>
        </template>

        <div>
          <label for="order-notes" class="font-sans-ui text-[0.7rem] uppercase tracking-[0.14em] font-bold text-brand-red-dark mb-2 block">
            Specific order demands <span class="text-text-ink-muted normal-case tracking-normal font-normal">(optional)</span>
          </label>
          <textarea
            id="order-notes"
            name="entry.1884144787"
            rows="3"
            placeholder="Foil vs. non-foil, condition, alternates if something's out of stock..."
            class="w-full rounded-md border border-brand-red/25 bg-white px-4 py-3 font-serif-body text-base text-text-ink placeholder:text-text-ink-muted/50 focus:outline-none focus:border-brand-red/60 focus:ring-2 focus:ring-brand-red/25 transition-colors resize-y"
          ></textarea>
          <p class="font-sans-ui text-xs text-text-ink-muted mt-2">
            Anything else we should know before we place the order — got more than one item? Use "+ Add another item" above rather than listing it here.
          </p>
        </div>

        <!-- Disclaimers — both required. Values must match the live form's
             checkbox option text exactly (see FORM_ACTION comment above). -->
        <div class="flex flex-col gap-3 border-t border-brand-red/15 pt-5">
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="entry.1646164105"
              value={DISCLAIMER_PICKUP}
              required
              class="mt-1 h-4 w-4 shrink-0 accent-brand-red"
            />
            <span class="font-serif-body text-sm leading-relaxed text-text-ink/90">
              I understand that I'll need to pick up my item(s) from Underline Center in person on one of the upcoming MTG Saturdays. I'll let Ravi know in advance which Saturday I'm coming for pickup.
            </span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="entry.1646164105"
              value={DISCLAIMER_TIMELINE}
              required
              class="mt-1 h-4 w-4 shrink-0 accent-brand-red"
            />
            <span class="font-serif-body text-sm leading-relaxed text-text-ink/90">
              I understand that items may take approximately 15–30 days to arrive after the order is placed.
            </span>
          </label>
        </div>

        <button
          type="submit"
          id="order-submit"
          class="btn-tap rounded-md text-center font-sans-ui text-xs font-bold uppercase tracking-[0.16em] px-5 py-3 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Submit Order
        </button>
      </form>

      <div id="order-success" class="callout-dashed-gold text-center px-6 py-10 hidden">
        <p class="font-serif-title text-mtg-gold uppercase tracking-wide text-lg font-bold">
          Order sent!
        </p>
        <p class="font-serif-body italic text-text-ink/90 mt-3 leading-relaxed">
          We've got it — we'll be in touch to confirm pickup. Don't forget to let Ravi know which Saturday works for you.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("order-form") as HTMLFormElement | null;
  const iframe = document.getElementById("order-hidden-frame") as HTMLIFrameElement | null;
  const submitBtn = document.getElementById("order-submit") as HTMLButtonElement | null;
  const successEl = document.getElementById("order-success");

  // ── Dynamic item rows ──────────────────────────────────────────────────
  // Each row is its own product + link + quantity. The Google Form itself
  // has no concept of "items" — it only has one paragraph field for this —
  // so right before the real submit fires, flattenItemsIntoFields() collapses
  // however many rows exist into a single multi-line summary in that field.
  const itemsContainer = document.getElementById("order-items");
  const itemTemplate = document.getElementById("order-item-template") as HTMLTemplateElement | null;
  const addItemBtn = document.getElementById("add-item-btn");
  const totalQtyEl = document.getElementById("order-total-qty");
  const itemsField = document.getElementById("order-items-field") as HTMLInputElement | null;

  function itemRows(): HTMLElement[] {
    return Array.from(itemsContainer?.querySelectorAll<HTMLElement>("[data-item]") ?? []);
  }

  function renumberItems() {
    const rows = itemRows();
    rows.forEach((row, i) => {
      const label = row.querySelector(".item-index");
      if (label) label.textContent = `Item ${i + 1}`;
      row.querySelector(".remove-item-btn")?.classList.toggle("hidden", rows.length <= 1);
    });
  }

  function updateTotals() {
    const total = itemRows().reduce((sum, row) => {
      const input = row.querySelector<HTMLInputElement>(".item-qty-input");
      return sum + (Number(input?.value) || 0);
    }, 0);
    if (totalQtyEl) totalQtyEl.textContent = String(total);
  }

  function bindRow(row: HTMLElement) {
    row.querySelector(".remove-item-btn")?.addEventListener("click", () => {
      row.remove();
      renumberItems();
      updateTotals();
    });
    row.querySelector(".item-qty-input")?.addEventListener("input", updateTotals);
  }

  function addItem() {
    if (!itemTemplate || !itemsContainer) return;
    const fragment = itemTemplate.content.cloneNode(true) as DocumentFragment;
    const row = fragment.querySelector<HTMLElement>("[data-item]");
    itemsContainer.appendChild(fragment);
    if (row) bindRow(row);
    renumberItems();
    updateTotals();
  }

  addItemBtn?.addEventListener("click", addItem);

  // Seed with a single row on load — the common case looks just like a
  // normal one-item form.
  if (itemsContainer && itemsContainer.children.length === 0) {
    addItem();
  }

  function flattenItemsIntoFields() {
    const rows = itemRows();
    const lines: string[] = [];

    rows.forEach((row, i) => {
      const name = row.querySelector<HTMLTextAreaElement>(".item-name-input")?.value.trim() ?? "";
      const link = row.querySelector<HTMLInputElement>(".item-link-input")?.value.trim() ?? "";
      const qty = Number(row.querySelector<HTMLInputElement>(".item-qty-input")?.value) || 0;
      if (!name) return;

      // Quantity and link no longer have their own form fields, so they ride
      // along in the same line as the product name/description.
      let line = `${name} — Qty: ${qty}`;
      if (link) line += ` — Link: ${link}`;
      // Single item: no numbering (reads like a normal paragraph answer).
      // Multiple items: number each line so Ravi can tell them apart.
      lines.push(rows.length > 1 ? `${i + 1}. ${line}` : line);
    });

    if (itemsField) itemsField.value = lines.join("\n");
  }

  // ── Submission (hidden-iframe POST, unchanged) ─────────────────────────
  if (form && iframe && submitBtn) {
    // The hidden iframe fires "load" once immediately (about:blank) and again
    // after Google Forms accepts the POST — only the second one should count.
    let submitting = false;

    iframe.addEventListener("load", () => {
      if (!submitting) return;
      submitting = false;
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit Order";
      form.classList.add("hidden");
      successEl?.classList.remove("hidden");
      successEl?.scrollIntoView({ behavior: "smooth", block: "center" });
    });

    form.addEventListener("submit", () => {
      flattenItemsIntoFields();
      submitting = true;
      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting…";
    });
  }
</script>
