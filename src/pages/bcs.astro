---
import Layout from "../layouts/Layout.astro";

/**
 * /bcs — Bangalore Card Show Standard MTG Tournament Sign-up.
 * Embedded Google Form allowing native authentication, response editing, and email receipts.
 */
const BMS_TICKETS_URL =
  "https://in.bookmyshow.com/events/bangalore-card-show/ET00519453";
const WHATSAPP_COMMUNITY_URL = "https://reroll.in/whatsapp-mtg";
const GOOGLE_FORM_EMBED_URL =
  "https://docs.google.com/forms/d/e/1FAIpQLSfkSjcNPviJbWSImgfPfXmS7twKlh29Rb6Om2MHdCNZVt6PlA/viewform?embedded=true";
const GOOGLE_FORM_DIRECT_URL =
  "https://docs.google.com/forms/d/e/1FAIpQLSfkSjcNPviJbWSImgfPfXmS7twKlh29Rb6Om2MHdCNZVt6PlA/viewform";
---

<Layout
  title="Bangalore Card Show Standard MTG Tournament"
  seoTitle="Bangalore Card Show Standard MTG Tournament Sign Up | ReRoll MTG Bangalore"
  description="Sign up for the Bangalore Card Show Magic: The Gathering tournament by submitting your details and deck details. First rounds 14th Nov (12 noon to 4 pm), finals 15th Nov."
  showHeading={false}
  showAnnouncement={false}
>
  <section class="w-full max-w-2xl mx-auto">
    <div class="mb-4">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 font-sans-ui text-xs uppercase tracking-[0.16em] font-bold text-brand-red hover:text-brand-red-dark transition-colors"
      >
        <span aria-hidden="true">←</span> Back to Home
      </a>
    </div>

    <h2
      class="font-serif-title title-glow text-center text-2xl md:text-3xl font-bold uppercase tracking-[0.14em] mb-3"
    >
      Bangalore Card Show
    </h2>
    <p class="text-center font-serif-body italic text-text-ink-muted mb-6">
      Standard MTG Tournament · 14th &amp; 15th Nov · 12:00 noon to 4:00 PM
    </p>

    <!-- Ticket & Tournament Prize CTA -->
    <div class="callout-dashed-gold px-5 py-5 mb-8 text-center flex flex-col items-center gap-3">
      <p class="font-serif-body text-base md:text-lg text-text-ink font-semibold leading-relaxed max-w-xl">
        Register and participate to win packs from Magic's latest set <span class="blue-foil-text font-bold">Reality Fracture</span>!
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto pt-1">
        <a
          href={BMS_TICKETS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-tap rounded-md font-sans-ui text-xs font-bold uppercase tracking-[0.16em] px-6 py-3 text-center w-full sm:w-auto"
        >
          Buy Your Ticket
        </a>
        <a
          href="#registration-form"
          id="open-form-btn"
          class="rounded-md border border-brand-red/35 bg-white/85 px-5 py-3 font-sans-ui text-xs font-bold uppercase tracking-[0.14em] text-brand-red hover:bg-brand-red-pale hover:border-brand-red transition-colors text-center w-full sm:w-auto"
        >
          Fill Registration Form ↓
        </a>
      </div>
    </div>

    <!-- Collapsible Embedded Google Form Container -->
    <details
      id="registration-form"
      class="faq-item group border-2 border-brand-red/30 rounded-xl bg-paper shadow-sm overflow-hidden scroll-mt-6 transition-all mb-8"
    >
      <summary
        class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 bg-paper-warm/50 hover:bg-brand-red-pale/40 transition-colors select-none"
      >
        <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-base md:text-lg leading-snug">
          Tournament Registration &amp; Decklist Form
        </span>
        <span
          class="shrink-0 text-brand-red text-2xl font-light leading-none select-none transition-transform duration-300 group-open:rotate-45"
          aria-hidden="true"
        >+</span>
      </summary>

      <div class="border-t border-brand-red/20 bg-white p-2 sm:p-4">
        <iframe
          src={GOOGLE_FORM_EMBED_URL}
          width="100%"
          height="1400"
          loading="lazy"
          title="Bangalore Card Show Standard MTG Tournament Sign-up Form"
          class="w-full min-h-[1400px] border-0 block"
        >
          Loading form…
        </iframe>

        <p class="font-sans-ui text-xs text-center text-text-ink-muted pt-4 pb-2">
          Having trouble viewing the form? <a
            href={GOOGLE_FORM_DIRECT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-brand-red font-semibold"
          >Open directly in Google Forms</a>.
        </p>
      </div>
    </details>

    <!-- FAQ Section -->
    <div class="pt-10 border-t border-brand-red/20">
      <h3 class="font-serif-title title-glow text-center text-xl md:text-2xl font-bold uppercase tracking-[0.14em] mb-2">
        Frequently Asked Questions
      </h3>
      <p class="text-center font-serif-body italic text-text-ink-muted text-sm mb-6">
        Everything you need to know about participating in the tournament and joining us at BCS.
      </p>

      <div class="flex flex-col gap-4">
        <!-- Q1: BCS Ticket -->
        <details class="faq-item group">
          <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4">
            <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-sm md:text-base leading-snug">
              Do I need to buy a Bangalore Card Show ticket to participate?
            </span>
            <span
              class="shrink-0 text-brand-red-light text-xl leading-none select-none transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              Yes — you need a valid entry ticket to the Bangalore Card Show to enter the venue and participate in the tournament. You can <a href={BMS_TICKETS_URL} target="_blank" rel="noopener noreferrer" class="text-brand-red font-semibold underline underline-offset-4 decoration-brand-red/40 hover:text-brand-red-dark transition-colors">buy your ticket on BookMyShow</a>.
            </p>
          </div>
        </details>

        <!-- Q2: Timings & Non-tournament visitors -->
        <details class="faq-item group">
          <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4">
            <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-sm md:text-base leading-snug">
              What are the timings? Can I stop by if I'm not in the tournament?
            </span>
            <span
              class="shrink-0 text-brand-red-light text-xl leading-none select-none transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              The tournament rounds run from <strong>12:00 noon to 4:00 PM</strong> on both days (14th Nov for preliminary rounds, and 15th Nov for qualifiers and finals).
            </p>
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              However, our team will be there the <strong>whole day</strong>! Feel free to stop by anytime to say hi, learn how to play Magic with beginner-friendly decks, buy a booster pack to crack, or play casual games.
            </p>
          </div>
        </details>

        <!-- Q3: Tournament Prizes -->
        <details class="faq-item group">
          <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4">
            <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-sm md:text-base leading-snug">
              What are the prizes for the tournament?
            </span>
            <span
              class="shrink-0 text-brand-red-light text-xl leading-none select-none transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              Participants and winners will have the chance to win booster packs from Magic's latest set, <span class="blue-foil-text font-bold">Reality Fracture</span>!
            </p>
          </div>
        </details>

        <!-- Q4: Proxy Policy -->
        <details class="faq-item group">
          <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4">
            <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-sm md:text-base leading-snug">
              Are proxies allowed in the tournament?
            </span>
            <span
              class="shrink-0 text-brand-red-light text-xl leading-none select-none transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              <strong>Strictly NO proxies are allowed.</strong> All cards in your 60-card minimum mainboard and optional 15-card sideboard must be genuine Magic: The Gathering cards legal in the current Standard format.
            </p>
          </div>
        </details>

        <!-- Q5: Editing decklist -->
        <details class="faq-item group">
          <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4">
            <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-sm md:text-base leading-snug">
              Can I edit my decklist after submitting?
            </span>
            <span
              class="shrink-0 text-brand-red-light text-xl leading-none select-none transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              Yes. If you enter your email in the registration form, Google Forms will send you a confirmation email containing an <strong>"Edit response"</strong> link so you can adjust your decklist anytime before the tournament begins.
            </p>
          </div>
        </details>

        <!-- Q6: Community & Trading -->
        <details class="faq-item group">
          <summary class="faq-summary flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4">
            <span class="font-serif-title text-brand-red font-bold uppercase tracking-wide text-sm md:text-base leading-snug">
              How can I trade cards or connect with the Bangalore MTG community?
            </span>
            <span
              class="shrink-0 text-brand-red-light text-xl leading-none select-none transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <div class="px-5 pb-5 pt-1 flex flex-col gap-3">
            <p class="font-serif-body text-[1.02rem] leading-relaxed text-text-ink/90">
              Join our <a href={WHATSAPP_COMMUNITY_URL} target="_blank" rel="noopener noreferrer" class="text-brand-red font-semibold underline underline-offset-4 decoration-brand-red/40 hover:text-brand-red-dark transition-colors">Bangalore MTG WhatsApp Group</a>! It's the central place where local players discuss decklists, plan card trades, ask questions, and stay up to date on all Bangalore MTG events and weekly meetups.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <script>
    function initCollapsibleForm() {
      const details = document.getElementById("registration-form");
      const trigger = document.getElementById("open-form-btn");

      if (trigger && details) {
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          if (details instanceof HTMLDetailsElement) {
            details.open = true;
          }
          details.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }

      if (window.location.hash === "#registration-form" && details instanceof HTMLDetailsElement) {
        details.open = true;
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCollapsibleForm);
    } else {
      initCollapsibleForm();
    }
  </script>
</Layout>
